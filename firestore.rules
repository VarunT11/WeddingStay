rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function member(wedding) {
      return get(/databases/$(database)/documents/weddings/$(wedding)/members/$(request.auth.uid)).data;
    }

    function appOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/appOwners/$(request.auth.uid))
        && get(/databases/$(database)/documents/appOwners/$(request.auth.uid)).data.active == true;
    }

    function active(wedding) {
      return appOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/weddings/$(wedding)/members/$(request.auth.uid))
          && member(wedding).active == true
          && member(wedding).role in ['owner', 'coordinator']);
    }

    function owner(wedding) {
      return appOwner();
    }

    function taskAccess(wedding) {
      return active(wedding) && (appOwner() || member(wedding).get('taskRole', 'none') in ['manager', 'participant']);
    }

    function taskManager(wedding) {
      return active(wedding) && (appOwner() || member(wedding).get('taskRole', 'none') == 'manager');
    }

    function taskTeamChange(wedding) {
      return taskManager(wedding)
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskRole', 'taskUpdatedBy', 'taskUpdatedAt'])
        && request.resource.data.taskRole in ['none', 'participant', 'manager']
        && request.resource.data.taskUpdatedBy == request.auth.uid
        && request.resource.data.taskUpdatedAt == request.time
        && (appOwner() || resource.data.get('taskRole', 'none') != 'manager');
    }

    function validTask(wedding, id) {
      let value = request.resource.data.data;
      return value is map
        && value.keys().hasOnly(['id', 'title', 'categoryId', 'notes', 'assignee', 'helpers', 'priority', 'dueDate', 'dueAt', 'status', 'blockedReason', 'checklist', 'checklistIds', 'checkedSteps', 'link', 'archived', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'completedAt', 'completedBy'])
        && value.id == id
        && value.title is string && value.title.size() > 0 && value.title.size() <= 200
        && value.categoryId is string
        && value.status in ['To do', 'In progress', 'Blocked', 'Done']
        && value.priority in ['Low', 'Normal', 'High']
        && value.notes is string && value.notes.size() <= 10000
        && value.blockedReason is string && value.blockedReason.size() <= 2000
        && (value.status != 'Blocked' || value.blockedReason.size() > 0)
        && value.archived is bool && value.assignee is string && value.helpers is list
        && value.checklist is list && value.checklist.size() <= 50
        && value.checklistIds is list && value.checkedSteps is list
        && value.checkedSteps.hasOnly(value.checklistIds)
        && value.checkedSteps.size() == value.checkedSteps.toSet().size()
        && value.updatedBy == request.auth.uid
        && value.completedAt is string && value.completedBy is string
        && ((value.status == 'Done' && value.completedAt.size() > 0 && value.completedBy.size() > 0)
          || (value.status != 'Done' && value.completedAt == '' && value.completedBy == ''));
    }

    function taskProgressOnly() {
      let old = resource.data.data;
      let value = request.resource.data.data;
      return resource.data.deleted == false
        && old.archived == false
        && (old.assignee == request.auth.uid || request.auth.uid in old.helpers)
        && (value.status != 'Done'
          || (old.status == 'Done' && value.completedAt == old.completedAt && value.completedBy == old.completedBy)
          || (old.status != 'Done' && value.completedBy == request.auth.uid))
        && value.diff(old).affectedKeys().hasOnly(['status', 'blockedReason', 'checkedSteps', 'updatedAt', 'updatedBy', 'completedAt', 'completedBy']);
    }

    function taskRecordWrite(wedding) {
      let root = /databases/$(database)/documents/weddings/$(wedding)/taskWorkspace/state;
      let before = exists(root) ? get(root).data.revision : 0;
      let after = getAfter(root).data;
      return after.revision == before + 1
        && after.updatedBy == request.auth.uid
        && after.updatedAt == request.time
        && request.resource.data.revision == after.revision;
    }

    function validMembership(wedding, uid) {
      let value = request.resource.data;
      let index = getAfter(/databases/$(database)/documents/users/$(uid)/weddings/$(wedding)).data;

      return value.keys().hasOnly([
          'role', 'active', 'grantedBy', 'grantedAt', 'updatedBy', 'updatedAt', 'displayName', 'taskRole', 'taskUpdatedBy', 'taskUpdatedAt'
        ])
        && value.role == 'coordinator'
        && value.get('taskRole', 'none') in ['none', 'participant', 'manager']
        && value.get('displayName', '') is string
        && value.get('displayName', '').size() <= 200
        && value.active is bool
        && value.updatedBy == request.auth.uid
        && value.updatedAt == request.time
        && index.weddingId == wedding
        && index.active == value.active
        && index.updatedBy == request.auth.uid
        && index.updatedAt == request.time;
    }

    match /appOwners/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || appOwner());
      allow list: if appOwner();
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || appOwner());
      allow list: if appOwner();

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.updatedAt == request.time
        && (
          (!exists(/databases/$(database)/documents/users/$(uid))
            && request.resource.data.createdAt == request.time)
          || (exists(/databases/$(database)/documents/users/$(uid))
            && request.resource.data.createdAt == resource.data.createdAt)
        );

      allow delete: if false;

      match /weddings/{wedding} {
        allow get, list: if appOwner()
          || (signedIn()
            && request.auth.uid == uid
            && resource.data.active == true);

        allow create, update: if appOwner()
          && request.resource.data.keys().hasOnly([
            'weddingId', 'weddingName', 'active', 'updatedBy', 'updatedAt'
          ])
          && request.resource.data.weddingId == wedding
          && request.resource.data.weddingName is string
          && request.resource.data.weddingName.size() <= 200
          && request.resource.data.active is bool
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/weddings/$(wedding)/members/$(uid)).data.active == request.resource.data.active
          && getAfter(/databases/$(database)/documents/weddings/$(wedding)/members/$(uid)).data.updatedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/weddings/$(wedding)/members/$(uid)).data.updatedAt == request.time;

        allow delete: if false;
      }
    }

    function head(wedding) {
      return get(/databases/$(database)/documents/weddings/$(wedding)).data;
    }

    function afterHead(wedding) {
      return getAfter(/databases/$(database)/documents/weddings/$(wedding)).data;
    }

    function recordCollection(kind) {
      return kind in [
        'guestCategories', 'guests', 'events', 'invitations',
        'properties', 'areas', 'rooms', 'allocations',
        'requirements', 'labels', 'history'
      ];
    }

    function versionOf(value) {
      return value.get('activeVersion', '');
    }

    function validRecord(id) {
      return request.resource.data.keys().hasOnly([
          'data', 'deleted', 'revision', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.deleted is bool
        && request.resource.data.revision is int
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.deleted == true && request.resource.data.data == null)
          || (request.resource.data.data is map && request.resource.data.data.id == id)
        );
    }

    function liveWrite(wedding, kind, version) {
      return head(wedding).state == 'ready'
        && versionOf(head(wedding)) == version
        && versionOf(afterHead(wedding)) == version
        && afterHead(wedding).revision == head(wedding).revision + 1
        && afterHead(wedding).updatedBy == request.auth.uid
        && request.resource.data.revision == afterHead(wedding).revision
        && afterHead(wedding).collectionRevisions[kind] == afterHead(wedding).revision;
    }

    function staged(wedding, version) {
      return get(/databases/$(database)/documents/weddings/$(wedding)/versions/$(version)).data;
    }

    match /weddings/{wedding} {
      allow get: if active(wedding);
      allow list: if appOwner();
      allow delete: if false;

      allow create: if owner(wedding)
        && request.resource.data.state == 'initializing'
        && request.resource.data.clientSchema == 4
        && request.resource.data.revision == 0
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if active(wedding)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.clientSchema == 4
        && resource.data.get('clientSchema', 0) <= 4
        && request.resource.data.schemaRevision == request.resource.data.revision
        && (
          (resource.data.state == 'ready'
            && request.resource.data.state == 'ready'
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'revision', 'clientSchema', 'schemaRevision',
              'collectionRevisions', 'updatedAt', 'updatedBy'
            ]))
          || (owner(wedding)
            && resource.data.state == 'ready'
            && request.resource.data.state == 'ready'
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'revision', 'clientSchema', 'schemaRevision', 'collectionRevisions', 'updatedAt', 'updatedBy', 'wedding'
            ])
            && request.resource.data.wedding.keys().hasOnly(['name', 'defaultDate'])
            && request.resource.data.wedding.name is string
            && request.resource.data.wedding.name.size() > 0
            && request.resource.data.wedding.name.size() <= 200
            && request.resource.data.wedding.defaultDate is string
            && request.resource.data.wedding.defaultDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          || (owner(wedding)
            && resource.data.state == 'ready'
            && request.resource.data.state == 'ready'
            && request.resource.data.revision == resource.data.revision + 1
            && versionOf(request.resource.data) != versionOf(resource.data)
            && request.resource.data.previousVersion == (versionOf(resource.data) == '' ? 'legacy' : versionOf(resource.data))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'activeVersion', 'previousVersion', 'clientSchema', 'schemaRevision',
              'revision', 'collectionRevisions', 'wedding', 'version',
              'referenceData', 'createdAt', 'updatedAt', 'updatedBy'
            ])
            && staged(wedding, request.resource.data.activeVersion).state == 'ready'
            && staged(wedding, request.resource.data.activeVersion).createdBy == request.auth.uid
            && staged(wedding, request.resource.data.activeVersion).baseRevision == resource.data.revision
            && staged(wedding, request.resource.data.activeVersion).baseVersion == versionOf(resource.data))
          || (owner(wedding)
            && resource.data.state != 'ready'
            && request.resource.data.state in ['initializing', 'ready']
            && (resource.data.state != 'initializing'
              || request.resource.data.importHash == resource.data.importHash))
        );

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || owner(wedding));
        allow list: if taskAccess(wedding);

        allow create: if appOwner()
          && exists(/databases/$(database)/documents/weddings/$(wedding))
          && exists(/databases/$(database)/documents/users/$(uid))
          && validMembership(wedding, uid)
          && request.resource.data.grantedBy == request.auth.uid
          && request.resource.data.grantedAt == request.time;

        allow update: if taskTeamChange(wedding)
          || (appOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
            && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200)
          || (appOwner()
          && validMembership(wedding, uid)
          && (
            (resource.data.keys().hasAll(['grantedBy', 'grantedAt'])
              && request.resource.data.grantedBy == resource.data.grantedBy
              && request.resource.data.grantedAt == resource.data.grantedAt)
            || (!resource.data.keys().hasAll(['grantedBy', 'grantedAt'])
              && request.resource.data.grantedBy == request.auth.uid
              && request.resource.data.grantedAt == request.time)
          ));

        allow delete: if false;
      }

      match /taskWorkspace/state {
        allow read: if taskAccess(wedding);
        allow create: if taskAccess(wedding)
          && request.resource.data.keys().hasOnly(['schema', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.schema == 1 && request.resource.data.revision == 1
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
        allow update: if taskAccess(wedding)
          && request.resource.data.keys().hasOnly(['schema', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.schema == 1 && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
        allow delete: if false;

        match /{kind}/{id} {
          allow read: if kind in ['categories', 'tasks', 'activity'] && taskAccess(wedding);
          allow create, update: if taskAccess(wedding)
            && validRecord(id) && taskRecordWrite(wedding)
            && ((kind == 'categories' && taskManager(wedding)
                && (request.resource.data.deleted == true || (request.resource.data.data.name is string && request.resource.data.data.name.size() > 0 && request.resource.data.data.name.size() <= 100 && request.resource.data.data.archived is bool)))
              || (kind == 'tasks' && request.resource.data.deleted == false && validTask(wedding, id)
                && (taskManager(wedding) || taskProgressOnly()))
              || (kind == 'activity'
                && !exists(/databases/$(database)/documents/weddings/$(wedding)/taskWorkspace/state/activity/$(id))
                && request.resource.data.deleted == false
                && request.resource.data.data.actor == request.auth.uid
                && request.resource.data.data.action is string
                && request.resource.data.data.action.size() <= 1000
                && (taskManager(wedding) || (request.resource.data.data.taskId is string
                  && (get(/databases/$(database)/documents/weddings/$(wedding)/taskWorkspace/state/tasks/$(request.resource.data.data.taskId)).data.data.assignee == request.auth.uid
                    || request.auth.uid in get(/databases/$(database)/documents/weddings/$(wedding)/taskWorkspace/state/tasks/$(request.resource.data.data.taskId)).data.data.helpers)))));
          allow delete: if false;
        }
      }

      match /{kind}/{id} {
        allow read: if recordCollection(kind)
          && active(wedding)
          && (owner(wedding)
            || (head(wedding).state == 'ready' && versionOf(head(wedding)) == ''));

        allow create, update: if recordCollection(kind)
          && active(wedding)
          && validRecord(id)
          && (
            (head(wedding).state == 'initializing'
              && owner(wedding)
              && request.resource.data.revision == 1)
            || liveWrite(wedding, kind, '')
          )
          && (kind != 'history'
            || !exists(/databases/$(database)/documents/weddings/$(wedding)/history/$(id))
            || head(wedding).state == 'initializing');

        allow delete: if false;
      }

      match /versions/{version} {
        allow read: if active(wedding) && (owner(wedding) || versionOf(head(wedding)) == version);

        allow create: if owner(wedding)
          && head(wedding).state == 'ready'
          && request.resource.data.keys().hasOnly([
            'state', 'baseRevision', 'baseVersion', 'createdBy', 'createdAt'
          ])
          && request.resource.data.state == 'uploading'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.baseRevision == head(wedding).revision
          && request.resource.data.baseVersion == versionOf(head(wedding));

        allow update: if owner(wedding)
          && resource.data.createdBy == request.auth.uid
          && resource.data.state == 'uploading'
          && request.resource.data.state == 'ready'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']);

        allow delete: if false;

        match /{kind}/{id} {
          allow read: if recordCollection(kind)
            && active(wedding)
            && (owner(wedding) || versionOf(head(wedding)) == version);

          allow create, update: if recordCollection(kind)
            && active(wedding)
            && validRecord(id)
            && (
              (owner(wedding)
                && staged(wedding, version).state == 'uploading'
                && staged(wedding, version).createdBy == request.auth.uid
                && request.resource.data.deleted == false
                && request.resource.data.revision == staged(wedding, version).baseRevision + 1)
              || (liveWrite(wedding, kind, version)
                && (kind != 'history'
                  || !exists(/databases/$(database)/documents/weddings/$(wedding)/versions/$(version)/history/$(id))))
            );

          allow delete: if false;
        }
      }
    }
  }
}
