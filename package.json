{
  "name": "weddingstay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules --project weddingstay-d0be2",
